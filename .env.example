# ================================
# MBA FUTBOL CLUB — Variables de entorno
# Copiar este archivo como .env.local y llenar los valores
# NUNCA subir .env.local a Git
# ================================

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXX

# Email desde el que se envían notificaciones
# Debe ser un dominio verificado en Resend, o usar onboarding@resend.dev para pruebas
RESEND_FROM_EMAIL=noreply@mbafutbol.com

# URL del sitio (sin trailing slash)
NEXT_PUBLIC_SITE_URL=https://mba-futbol.vercel.app

# Zona horaria Colombia
TZ=America/Bogota
